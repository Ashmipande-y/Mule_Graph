# Copy to backend/.env for local overrides. No credentials belong here.
#
# Precedence (highest wins): process environment > this file > built-in
# default. A process environment variable of the same name always beats
# whatever is set here.

# Comma-separated list of allowed frontend origins. Uncomment to override
# the default (http://localhost:3000,http://127.0.0.1:3000 -- both loopback
# forms, since a browser treats them as different origins).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Override the transaction source path (absolute, or relative to the repo root).
# DEMO_TRANSACTIONS_PATH=data/demo_transactions.json

# Override the AML dataset paths (absolute, or relative to the repo root).
# Both are optional (AML_MODE=optional) -- a missing labels file just means
# no ground-truth-labeled examples are offered, not a broken service.
# AML_TRANSFERS_PATH=data/aml/transfers_inr.csv
# AML_LABELS_PATH=data/aml/transfer_labels_and_splits.csv

LOG_LEVEL=INFO
# Durable case snapshots and analyst decisions (relative to repository root).
CASE_DB_PATH=backend/.runtime/cases.sqlite3
